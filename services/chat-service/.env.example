# Copy values into the shell; .env files are not loaded automatically.
# These credentials are only for the local database from compose.yaml.
CHAT_DATABASE_URL=postgres://chat:chat-local@127.0.0.1:5433/chatdb?sslmode=disable
HTTP_ADDR=127.0.0.1:6767
ROOM_SERVICE_URL=http://127.0.0.1:8000
# Docker profile app: Room Service reachable from inside the chat container.
ROOM_SERVICE_DOCKER_URL=http://host.docker.internal:8000
# Use 0.0.0.0 only if teammates need access from the local network.
CHAT_BIND_IP=127.0.0.1
CHAT_PORT=6767
