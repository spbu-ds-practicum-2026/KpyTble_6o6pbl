# В development можно не задавать:
# Vite отправит /api и /ws через локальный proxy.
VITE_API_BASE_URL=/api
VITE_WS_URL=

# Повтор команд реализован, но пока выключен,
# потому что текущий FakeRoomBackend не выполняет дедупликацию.
VITE_RETRY_PENDING_COMMANDS=false

# Интервалы WebSocket heartbeat.
VITE_HEARTBEAT_INTERVAL_MS=15000
VITE_HEARTBEAT_TIMEOUT_MS=8000

# Периодическая REST-сверка состояния.
VITE_STATE_SYNC_INTERVAL_MS=10000