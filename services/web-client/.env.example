# В development можно не задавать:
# Vite отправит /api и /ws через локальный proxy.
VITE_API_BASE_URL=/api
VITE_WS_URL=

# Повтор неподтверждённых команд с тем же commandId.
# По умолчанию включён; выключить можно значением false.
VITE_RETRY_PENDING_COMMANDS=true

# Клиент отвечает pong на pig от Gateway и переподключается,
# если pig не пришёл за это время (мс).
VITE_HEARTBEAT_TIMEOUT_MS=20000

# Период запросов getState и getChatSeq через WebSocket (мс).
VITE_STATE_SYNC_INTERVAL_MS=10000
